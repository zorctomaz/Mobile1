# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Expo CLI loads `.env` automatically — no extra setup needed.
#
# See README.md "Google Maps API ključ" for how to create these in Google
# Cloud Console. The Android key must be restricted to package
# host.exp.exponent with the Expo Go signing fingerprint while testing in
# Expo Go.

ANDROID_GOOGLE_MAPS_API_KEY=
IOS_GOOGLE_MAPS_API_KEY=
